{
  "name": "change-lens",
  "displayName": "Change Lens",
  "description": "Highlights the changes an agent makes to your files right inside VS Code: green added lines, red deleted lines, Accept and Revert buttons. Local diffing — no AI requests, no API keys, no settings.",
  "version": "0.8.0",
  "publisher": "pilich",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "diff",
    "inline diff",
    "ai",
    "agent",
    "deepseek",
    "harness",
    "copilot"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "changeLens.reviewChanges",
        "title": "Review Changed Files",
        "category": "Change Lens",
        "icon": "$(list-unordered)"
      },
      {
        "command": "changeLens.acceptChange",
        "title": "Accept Change",
        "category": "Change Lens",
        "icon": "$(check)"
      },
      {
        "command": "changeLens.revertChange",
        "title": "Revert Change",
        "category": "Change Lens",
        "icon": "$(discard)"
      },
      {
        "command": "changeLens.showChangeDiff",
        "title": "Show Change Diff",
        "category": "Change Lens",
        "icon": "$(diff)"
      },
      {
        "command": "changeLens.showOutput",
        "title": "Show Log",
        "category": "Change Lens",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "changeLens.acceptChange",
          "group": "1_modification@1",
          "when": "changeLens.change"
        },
        {
          "command": "changeLens.revertChange",
          "group": "1_modification@2",
          "when": "changeLens.change"
        },
        {
          "command": "changeLens.showChangeDiff",
          "group": "1_modification@3",
          "when": "changeLens.change"
        }
      ],
      "commandPalette": [
        {
          "command": "changeLens.acceptChange",
          "when": "changeLens.change"
        },
        {
          "command": "changeLens.revertChange",
          "when": "changeLens.change"
        },
        {
          "command": "changeLens.showChangeDiff",
          "when": "changeLens.change"
        }
      ]
    },
    "keybindings": [
      {
        "command": "changeLens.reviewChanges",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d"
      },
      {
        "command": "changeLens.acceptChange",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "changeLens.change"
      },
      {
        "command": "changeLens.revertChange",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "changeLens.change"
      }
    ]
  },
  "scripts": {
    "pack": "node scripts/pack.mjs"
  }
}
